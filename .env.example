# ==========================================
# Environment Variables Configuration Template
# ==========================================

# GEMINI_API_KEY: Required for Gemini AI API calls and workload NLP parsing.
# In local development: copy this file to .env and insert your real key.
# In Vercel / Render: add GEMINI_API_KEY to your Project Environment Variables.
GEMINI_API_KEY="your_gemini_api_key_here"

# Web server port (Vercel and Render inject their own PORT automatically)
PORT=3001

# Node Environment
NODE_ENV=production
